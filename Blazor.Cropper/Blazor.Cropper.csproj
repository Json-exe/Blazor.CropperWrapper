<Project Sdk="Microsoft.NET.Sdk.Razor">

    <PropertyGroup>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <PackageId>Json_exe.Blazor.Cropper</PackageId>
        <Version>0.6.0</Version>
        <Title>CropperJS Wrapper for Blazor</Title>
        <Authors>Json-exe</Authors>
        <Description>This is a wrapper around the CropperJS library.</Description>
        <Copyright>Json-exe 2026</Copyright>
        <PackageLicenseFile>LICENSE</PackageLicenseFile>
        <PackageReadmeFile>readme.md</PackageReadmeFile>
        <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
        <PackageProjectUrl>https://github.com/Json-exe/Blazor.CropperWrapper</PackageProjectUrl>
        <RepositoryUrl>https://github.com/Json-exe/Blazor.CropperWrapper</RepositoryUrl>
        <RepositoryType>Git</RepositoryType>
        <AssemblyName>Json_exe.Blazor.Cropper</AssemblyName>
        <RootNamespace>Json_exe.Blazor.Cropper</RootNamespace>
        <PackageIcon>Json_exe.Blazor.Cropper-Logo.png</PackageIcon>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <TargetFrameworks>net9.0;net10.0</TargetFrameworks>
    </PropertyGroup>


    <ItemGroup>
        <SupportedPlatform Include="browser"/>
    </ItemGroup>

    <ItemGroup Condition="'$(TargetFramework)' == 'net9.0'">
        <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="9.0.17"/>
    </ItemGroup>

    <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
        <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="10.0.9"/>
    </ItemGroup>

    <ItemGroup>
        <!-- cropperWrapper.ts is a build input only (esbuild -> cropperWrapper.js).
             Static web assets ignore Content Pack="false", so remove it from Content
             and keep it as None to exclude it from staticwebassets / NuGet. -->
        <Content Remove="wwwroot\cropperWrapper.ts" />
        <None Include="wwwroot\cropperWrapper.ts" Pack="false">
            <CopyToOutputDirectory>Never</CopyToOutputDirectory>
        </None>
        <Content Update="wwwroot\cropperWrapper.js">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </Content>
        <None Include="../readme.md" Pack="true" PackagePath="\"/>
        <None Include="../LICENSE" Pack="true" PackagePath="\"/>
        <None Include="../Json_exe.Blazor.Cropper-Logo.png" PackagePath="\" Pack="true"/>
    </ItemGroup>

    <ItemGroup>
        <TypeScriptCompile Include="wwwroot\cropperWrapper.ts" />
    </ItemGroup>

</Project>
